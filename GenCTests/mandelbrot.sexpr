(let-rec (dbl x) = (+. x x) in
(let-rec (yloop y) =
  (if (>= y 80) then ()
    else 
    (let-rec (xloop x y) = 
      (if (>= x 80) then (print_ln ()) 
        else
        (let cr = (-. (/. (dbl (float_of_int x)) 80.0) 1.5) in
        (let ci = (-. (/. (dbl (float_of_int y)) 80.0) 1.0) in
        (let-rec (iloop i zr zi zr2 zi2 cr ci) = 
          (if (= i 0) then (print_int 1)
            else
            (let tr = (+. (-. zr2 zi2) cr) in
            (let ti = (+. (*. (dbl zr) zi) ci) in
            (let zr = tr in
            (let zi = ti in
            (let zr2 = (*. zr zr) in
            (let zi2 = (*. zi zi) in
            (if (> (+. zr2 zi2) 4.0) then (print_int 0)
              else
              (iloop (- i 1) zr zi zr2 zi2 cr ci))))))))) in 
        (;
          (iloop 1000 0.0 0.0 0.0 0.0 cr ci)
          (xloop (+ x 1) y)))))) in
      (;
        (xloop 0 y)
        (yloop (+ y 1))))) in
(yloop 0)))