(let-rec (print-ppm-header _) = 
  (; 
    (put_char 80)
    (print_int_ln 3)
    (print_int 1024)
    (put_char 32)
    (print_int_ln 1024)
    (print_int_ln 255)) in
(let-rec (dbl x) = (+. x x) in
(let-rec (do-loop start end iter-action) : (_ _ (fn (i) -> u)) -> _ =
  (if (<= start end)
    then (; (iter-action start) (do-loop (+ start 1) end iter-action))
    else ()) in
(let-rec (y-loop-step y) =
  (let-rec (x-loop-step x) =
    (let cr = (-. (/. (dbl (float_of_int x)) 1024.0) 1.5) in
    (let ci = (-. (/. (dbl (float_of_int y)) 1024.0) 1.0) in
    (let-rec (iloop steps zr zi) =
      (if (= steps 0)
        then (; 
          (print_int 0) (print_tab ())
          (print_int 0) (print_tab ())
          (print_int 0) (print_tab ()))
        else
        (let (, zr2 zi2) = (, (*. zr zr) (*. zi zi)) in
        (let (, zi zr) = (, (+. (*. (dbl zr) zi) ci) (+. (-. zr2 zi2) cr)) in
        (if (> (+. zr2 zi2) 4.0)
          then
            (; 
              (print_int steps) (print_tab ())
              (print_int steps) (print_tab ())
              (print_int steps) (print_tab ())
            )
          else (iloop (- steps 1) zr zi))))) in
    (;основное-вычисление (iloop 255 0.0 0.0))))) in
  (;столбцы (do-loop 0 1023 x-loop-step) (print_ln ()))) in
(;заголовок-и-далее-ряды (print-ppm-header ()) (do-loop 0 1023 y-loop-step))))))