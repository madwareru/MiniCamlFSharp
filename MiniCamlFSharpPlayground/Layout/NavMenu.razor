            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ASTParsing">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Разбор в AST
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="KNorm">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> K-нормальная форма
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="KNormInterpreter">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Интерпретатор
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
